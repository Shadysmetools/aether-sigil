  "spec": {
    "backdrops": {
      "alpha": "opaque",
      "rules": "Portrait sky behind the board (per tower) or the world map (world). Keep the middle 50% calm: the board and HUD sit on it. world falls back to the key-art poster; a tower falls back to the procedural cloud-sky shader.",
      "size": "1080x1920"
    },
    "icons": {
      "alpha": "transparent",
      "rules": "Element family icon; readable down to 24 px.",
      "size": "256x256"
    },
    "monsters": {
      "alpha": "transparent cut-out",
      "rules": "Whole creature, 3/4 view facing the viewer's left, feet at (256,472) = 50% x, 92% y. Drawn standing on its tile, ~1.15 tile wide, with team ring + HP bar + element badge added by code; also cropped (top 60%) for turn-order chips and squad buttons. Lookup: monsters/MON-xxxx -> monsters/FAM-xxx -> monsters/<element family>. The list below is the evolution-family + element set; per-monster MON-xxxx files are optional overrides. Opaque rectangular crops are shown inside the team medallion instead of standing.",
      "size": "512x512"
    },
    "portraits": {
      "alpha": "opaque painted background OK",
      "rules": "Head and shoulders, eyes at ~38% height, face centred. Drawn cover-cropped into a square gold frame (230 px in dialogue). Id = speaker name lowercased, every run of non-letters/digits -> '_' (Kess Varrow -> kess_varrow). Tall crops (height > 1.5 x width) are framed at 62% height, so champion card crops work as-is.",
      "size": "512x512"
    },
    "props": {
      "alpha": "transparent",
      "rules": "Standing object. Foot anchor (128,352) = 50% x, 91.7% y, placed on the tile's top-face centre. Drawn ~0.7-0.95 tile wide. A tower may override one: props/T05/relic.png.",
      "size": "256x384 (or 512x768)"
    },
    "tiles": {
      "alpha": "transparent",
      "rules": "Isometric tile. Top face = 2:1 diamond 256 px wide. Ground-plane anchor at (128,248) = 50% x, 77.5% y, the same point on every tile. Raised types lift the top face by raise x 128 px: stone 0.35 (45 px), elevation 0.6 (77 px), obstacle 0.8 (102 px); every other type is a ~12 px slab. Floor engravings only on player_symbol / enemy_symbol / capsule_node / relic / warp_gate (the standing object is a prop). ground_v2/_v3 = variants; bridge = deck along board X, bridge_y = along Y.",
      "size": "256x320 (or 512x640)"
    },
    "towers": {
      "alpha": "opaque",
      "rules": "World-map card art: the tower's floating realm, no text. Shown in the top two-thirds of a 3:4 card (cover crop, focus 35% height); the card adds the name, element icon, stars and lock state.",
      "size": "640x400"
    },
    "ui": {
      "alpha": "transparent",
      "rules": "panel/panel_border 384x384 nine-patch, all margins 56 px (corner ornaments inside). panel/panel_header 384x64, margins L/R 40. turn_order/slot_* 144x144, portrait inset 16 px, index in the top-left 40 px. objective/checkbox_* 128x128. buttons/btn_* 192x192, no text (the label is code). logo: any size, transparent or on pure black (luma-keyed).",
      "size": "see notes"
    }
  },
  "total": 739
