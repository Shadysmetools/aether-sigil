## Writes art/ASSET-CONTRACT.md and art/asset_slots.json from assets.gd contract_slots(), so the
## list the art agent paints against can never drift from what the resolver looks up.
## Run: Godot --headless --path game --script res://tests/write_asset_contract.gd
extends SceneTree

const Assets = preload("res://scripts/assets.gd")
const Data = preload("res://scripts/data_loader.gd")

const SPEC := {
	"tiles": ["256x320 (or 512x640)", "transparent", "Isometric tile. Top face = 2:1 diamond 256 px wide. Ground-plane anchor at (128,248) = 50% x, 77.5% y, the same point on every tile. Raised types lift the top face by raise x 128 px: stone 0.35 (45 px), elevation 0.6 (77 px), obstacle 0.8 (102 px); every other type is a ~12 px slab. Floor engravings only on player_symbol / enemy_symbol / capsule_node / relic / warp_gate (the standing object is a prop). ground_v2/_v3 = variants; bridge = deck along board X, bridge_y = along Y."],
	"props": ["256x384 (or 512x768)", "transparent", "Standing object. Foot anchor (128,352) = 50% x, 91.7% y, placed on the tile's top-face centre. Drawn ~0.7-0.95 tile wide. A tower may override one: props/T05/relic.png."],
	"monsters": ["512x512", "transparent cut-out", "Whole creature, 3/4 view facing the viewer's left, feet at (256,472) = 50% x, 92% y. Drawn standing on its tile, ~1.15 tile wide, with team ring + HP bar + element badge added by code; also cropped (top 60%) for turn-order chips and squad buttons. Lookup: monsters/MON-xxxx -> monsters/FAM-xxx -> monsters/<element family>. The list below is the evolution-family + element set; per-monster MON-xxxx files are optional overrides. Opaque rectangular crops are shown inside the team medallion instead of standing."],
	"portraits": ["512x512", "opaque painted background OK", "Head and shoulders, eyes at ~38% height, face centred. Drawn cover-cropped into a square gold frame (230 px in dialogue). Id = speaker name lowercased, every run of non-letters/digits -> '_' (Kess Varrow -> kess_varrow). Tall crops (height > 1.5 x width) are framed at 62% height, so champion card crops work as-is."],
	"towers": ["640x400", "opaque", "World-map card art: the tower's floating realm, no text. Shown in the top two-thirds of a 3:4 card (cover crop, focus 35% height); the card adds the name, element icon, stars and lock state."],
	"backdrops": ["1080x1920", "opaque", "Portrait sky behind the board (per tower) or the world map (world). Keep the middle 50% calm: the board and HUD sit on it. world falls back to the key-art poster; a tower falls back to the procedural cloud-sky shader."],
	"icons": ["256x256", "transparent", "Element family icon; readable down to 24 px."],
	"ui": ["see notes", "transparent", "panel/panel_border 384x384 nine-patch, all margins 56 px (corner ornaments inside). panel/panel_header 384x64, margins L/R 40. turn_order/slot_* 144x144, portrait inset 16 px, index in the top-left 40 px. objective/checkbox_* 128x128. buttons/btn_* 192x192, no text (the label is code). logo: any size, transparent or on pure black (luma-keyed)."],
}


func _initialize() -> void:
	Data.ensure_loaded()
	var slots := Assets.contract_slots()
	var total := 0
	for k in slots:
		total += slots[k].size()
	var md := PackedStringArray()
	md.append("# Aether Sigil - asset contract (painted art drop-in)")
	md.append("")
	md.append("Generated by `game/tests/write_asset_contract.gd` from `game/scripts/assets.gd` `contract_slots()`. Do not edit by hand: re-run it after data changes. Machine-readable twin: `game/art/asset_slots.json`.")
	md.append("")
	md.append("**%d slots.** Every slot already has a fallback (generated placeholder or procedural drawing), so any subset can be delivered in any order and appears with **zero code changes**." % total)
	md.append("")
	md.append("## Where files go and how they are found")
	md.append("")
	md.append("`res://` is the `game/` folder. A slot id is a path without `.png`. For `portraits/kess_varrow` the resolver tries, first hit wins:")
	md.append("")
	md.append("1. `game/art/ai/portraits/kess_varrow.png` (restored / upscaled painted art, shipped)")
	md.append("2. `game/art/ai/from-concepts/portraits/kess_varrow.png` (crops of the owner's concept sheets)")
	md.append("3. `<repo>/art/ai/...` then `<repo>/art/ai/from-concepts/...` (the art agent's working folder, read directly in dev runs only; copy into `game/art/ai/` to ship)")
	md.append("4. `game/art/generated/png/...` (vector placeholders, see `art/generated/MANIFEST.md`)")
	md.append("5. bundled title art in `game/art/title/` (logo, key-art poster) for `ui/logo` and `backdrops/world` only")
	md.append("6. procedural drawing in code")
	md.append("")
	md.append("**Ids must match these folders exactly** (category folder + id). Files in `game/art/ai/` need one `Godot --headless --path game --import` before an exported build sees them; dev runs and tests load un-imported PNGs raw.")
	md.append("")
	md.append("### from-concepts naming the resolver already understands")
	md.append("")
	md.append("Crops in `from-concepts/` may keep their sheet-style names; they are indexed by a normalised key:")
	md.append("")
	md.append("| file | is used as |")
	md.append("|---|---|")
	md.append("| `towers/t01_verdant_spire_art.png` (beats `..._card`) | `towers/T01` |")
	md.append("| `champions/c01_lyra_quill.png` | `portraits/lyra_quill` |")
	md.append("| `protagonist/summoner_closeup.png` | `portraits/%s` (the protagonist) |" % Assets.slug(str(Data.story().protagonist.name)))
	md.append("| `monsters/m07_quillphoenix.png` (beats `evo_*_lv36`, beats `*_card`) | the monster named Quillphoenix, then its evolution family, then a representative of its element family |")
	md.append("| `key-art/key_art_poster.png` | `backdrops/world` |")
	md.append("| `logo/logo.png` | `ui/logo` |")
	md.append("")
	md.append("Canonical ids (the tables below) always work too and win over sheet-style names.")
	md.append("")
	md.append("## Slot summary")
	md.append("")
	md.append("| category | count | size (px) | alpha | rules |")
	md.append("|---|---:|---|---|---|")
	for k in slots:
		var sp: Array = SPEC.get(k, ["", "", ""])
		md.append("| `%s` | %d | %s | %s | %s |" % [k, slots[k].size(), sp[0], sp[1], sp[2]])
	md.append("| **total** | **%d** | | | |" % total)
	md.append("")
	md.append("Tower keys: " + ", ".join(Data.towers().map(func(t): return "`T%s` %s" % [t.tower_id, t.name])) + ".")
	md.append("")
	md.append("Tile types per tower (%d): %s." % [Assets.TILE_TYPES.size(), ", ".join(Assets.TILE_TYPES.map(func(t): return "`%s`" % t))])
	md.append("`sky`, `ruins`, `space`, `rift` appear only in map legends today (lowest priority).")
	md.append("")
	md.append("## Priority order for the art agent")
	md.append("")
	md.append("1. `portraits/` core cast (%d): %s" % [Assets.core_speakers().size(), ", ".join(Assets.core_speakers().map(func(s): return "`%s`" % Assets.slug(s)))])
	md.append("2. `towers/` (12) and `backdrops/` (13)")
	md.append("3. `monsters/` element families (12), then evolution families (FAM-001 first)")
	md.append("4. `tiles/` per tower (ground, obstacle, elevation, water, bridge first), `props/`")
	md.append("5. remaining `portraits/` (stage rivals), `ui/`")
	md.append("")
	md.append("## Every slot")
	for k in slots:
		md.append("")
		md.append("### %s (%d)" % [k, slots[k].size()])
		md.append("")
		if k == "tiles":
			md.append("`tiles/<T01..T12>/<type>` for every tower key x every tile type above.")
			continue
		if k == "portraits":
			var rows := []
			for s in Assets.speakers():
				rows.append("`portraits/%s` (%s)" % [Assets.slug(s), s])
			md.append(", ".join(rows))
			continue
		md.append(", ".join(slots[k].map(func(x): return "`%s`" % x)))
	md.append("")
	var f := FileAccess.open("res://art/ASSET-CONTRACT.md", FileAccess.WRITE)
	f.store_string("\n".join(md))
	f.close()
	var spec_json := {}
	for k in SPEC:
		spec_json[k] = {"size": SPEC[k][0], "alpha": SPEC[k][1], "rules": SPEC[k][2]}
	var j := FileAccess.open("res://art/asset_slots.json", FileAccess.WRITE)
	j.store_string(JSON.stringify({"total": total, "spec": spec_json, "slots": slots,
		"speakers": Assets.speakers().map(func(s): return {"name": s, "id": Assets.slug(s)}),
		"core_speakers": Assets.core_speakers().map(func(s): return Assets.slug(s))}, "  "))
	j.close()
	for k in slots:
		print("%-10s %d" % [k, slots[k].size()])
	print("total      %d" % total)
	quit(0)
