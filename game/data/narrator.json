  {
   "id": "bark_first_crack_early",
   "event": "first_crack",
   "phase": "early",
   "mood": "wry",
   "line": "A Vessel cracks. A frightful word, 'crack'. Carry on."
  },
  {
   "id": "bark_first_crack_mid",
   "event": "first_crack",
   "phase": "mid",
   "mood": "delighted",
   "line": "There. A Vessel opens, and something steps out. Lovely."
