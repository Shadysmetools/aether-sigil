   "event": "battle_start",
   "phase": "early",
   "mood": "wry",
   "line": "Another page begins. Do try to survive it, Summoner."
  },
  {
   "id": "bark_battle_start_mid",
   "event": "battle_start",
   "phase": "mid",
   "mood": "dry",
   "line": "Positions, everyone. I shall keep the margins clear."
