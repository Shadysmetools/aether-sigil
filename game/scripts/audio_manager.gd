## AudioManager (autoload): every sound in the game goes through here.
## - Buses Master > Music / SFX / Voice / Ambience are created at startup if the project has no
##   bus layout for them; per-bus volumes (linear 0..1) persist in user://audio_prefs.cfg.
## - Sound ids live in res://audio/audio_registry.json (generated by audio/tools/make_sfx.py);
##   see res://audio/HOOKS.md for which game event plays which id.
## - Headless-safe: every load is guarded by ResourceLoader.exists(), unknown ids and missing
##   files are silent no-ops (one push_warning per unknown id at most, never an error), and the
##   Dummy audio driver used by --headless plays nothing without complaint.
## - Voice lines: play_voice(line_id) / play_voice_line(speaker, text) look the line up in
##   res://audio/voices/voice_index.json (written by audio/tools/eleven_voices.py); a line that has
##   not been rendered yet simply does not play. Music is ducked while a voice line plays.
extends Node

signal voice_finished(line_id: String)

const REGISTRY_PATH := "res://audio/audio_registry.json"
const VOICE_INDEX_PATH := "res://audio/voices/voice_index.json"
const DEFAULT_PREFS_PATH := "user://audio_prefs.cfg"
const BUSES: Array[String] = ["Music", "SFX", "Voice", "Ambience"]
const DEFAULT_VOLUME := {"Master": 1.0, "Music": 0.7, "SFX": 1.0, "Voice": 1.0, "Ambience": 0.6}
const POOL_SIZE := 16        ## non-positional SFX players
const POOL_2D := 8
const POOL_3D := 8
const DUCK_DB := -9.0        ## music attenuation while a voice line plays
const DUCK_SPEED := 18.0     ## dB per second for duck / unduck

var prefs_path := DEFAULT_PREFS_PATH  ## tests point this at a temp file
var registry: Dictionary = {}
var voice_index: Dictionary = {}
var volumes: Dictionary = DEFAULT_VOLUME.duplicate()
var current_music := ""
var current_ambience := ""

var _streams: Dictionary = {}       ## res path -> AudioStream
var _pool: Array[AudioStreamPlayer] = []
var _pool_2d: Array[AudioStreamPlayer2D] = []
var _pool_3d: Array[AudioStreamPlayer3D] = []
var _next := {"flat": 0, "2d": 0, "3d": 0}
var _music: Array[AudioStreamPlayer] = []    ## two players, cross-faded
var _music_active := 0
var _amb: Array[AudioStreamPlayer] = []
var _amb_active := 0
var _voice: AudioStreamPlayer
var _voice_line := ""
var _duck := 0.0                   ## current duck offset in dB (0 or towards DUCK_DB)
var _warned: Dictionary = {}
var _fades: Dictionary = {}         ## player -> running volume Tween (killed before the player is reused)
var _rng := RandomNumberGenerator.new()
var _ready_done := false
## Headless (tests, CI): everything resolves and validates, but no player is started - a headless
## quit with a playback still running leaks it (see scenes/intro/studio_intro.gd).
var silent := DisplayServer.get_name() == "headless"


func _ready() -> void:
	setup()


## Idempotent init (tests call it directly on a fresh instance).
func setup() -> void:
	if _ready_done:
		return
	_ready_done = true
	process_mode = Node.PROCESS_MODE_ALWAYS
	_rng.randomize()
	ensure_buses()
	registry = _read_json(REGISTRY_PATH)
	voice_index = _read_json(VOICE_INDEX_PATH)
	for i in POOL_SIZE:
		_pool.append(_add_player(AudioStreamPlayer.new(), "SFX") as AudioStreamPlayer)
	for i in 2:
		_music.append(_add_player(AudioStreamPlayer.new(), "Music") as AudioStreamPlayer)
		_amb.append(_add_player(AudioStreamPlayer.new(), "Ambience") as AudioStreamPlayer)
	_voice = _add_player(AudioStreamPlayer.new(), "Voice") as AudioStreamPlayer
	_voice.finished.connect(_on_voice_finished)
	load_prefs()


## Creates any of BUSES that the current layout lacks, each sending to Master.
func ensure_buses() -> void:
	for b in BUSES:
		if AudioServer.get_bus_index(b) == -1:
			AudioServer.add_bus()
			var idx := AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, b)
			AudioServer.set_bus_send(idx, &"Master")


# ------------------------------------------------------------------ volume + prefs

## Sets a bus volume (linear 0..1) and saves it.
func set_volume(bus: String, linear: float) -> void:
	volumes[bus] = clampf(linear, 0.0, 1.0)
	_apply_volume(bus)
	save_prefs()


func get_volume(bus: String) -> float:
	return float(volumes.get(bus, 1.0))


func load_prefs() -> void:
	var cfg := ConfigFile.new()
	if FileAccess.file_exists(prefs_path) and cfg.load(prefs_path) == OK:
		for b in DEFAULT_VOLUME:
			volumes[b] = clampf(float(cfg.get_value("volume", b, DEFAULT_VOLUME[b])), 0.0, 1.0)
	for b in volumes:
		_apply_volume(b)


func save_prefs() -> void:
	var cfg := ConfigFile.new()
	for b in volumes:
		cfg.set_value("volume", b, volumes[b])
	cfg.save(prefs_path)


func _apply_volume(bus: String) -> void:
	var idx := AudioServer.get_bus_index(bus)
	if idx == -1:
		return
	var lin := float(volumes.get(bus, 1.0))
	var db := linear_to_db(maxf(lin, 0.0001))
	if bus == "Music":
		db += _duck
	AudioServer.set_bus_volume_db(idx, db)
	AudioServer.set_bus_mute(idx, lin <= 0.0001)


# ------------------------------------------------------------------ SFX

## True when `id` is a registered SFX id.
func has_sfx(id: String) -> bool:
	return registry.get("sfx", {}).has(id)


## All registered SFX ids.
func sfx_ids() -> Array:
	return registry.get("sfx", {}).keys()


## Plays SFX `id` (a random variant). `pos`: null = non-positional, Vector2 = 2D positional,
## Vector3 = 3D positional (heard from the root viewport's camera). `pitch_jitter` = max random
## pitch deviation (0.06 = +-6 %). Returns the player used, or null when nothing could play.
func play_sfx(id: String, pos: Variant = null, pitch_jitter: float = 0.0, volume_db: float = 0.0) -> Node:
	var entry: Dictionary = registry.get("sfx", {}).get(id, {})
	var files: Array = entry.get("files", [])
	if files.is_empty():
		_warn_once(id)
		return null
	var stream := _stream(str(files[_rng.randi_range(0, files.size() - 1)]))
	if stream == null:
		return null
	var pitch := 1.0 + (_rng.randf_range(-pitch_jitter, pitch_jitter) if pitch_jitter > 0.0 else 0.0)
	var p: Node
	if pos is Vector2:
		p = _take_2d()
		(p as AudioStreamPlayer2D).global_position = pos
	elif pos is Vector3:
		p = _take_3d()
		(p as AudioStreamPlayer3D).global_position = pos
	else:
		p = _take("flat")
	p.set("stream", stream)
	p.set("pitch_scale", pitch)
	p.set("volume_db", volume_db)
	if not silent:
		p.call("play")
	return p


func _take(kind: String) -> AudioStreamPlayer:
	# prefer an idle player; otherwise steal round-robin (oldest-ish)
	for pl in _pool:
		if not pl.playing:
			return pl
	var i: int = _next[kind] % _pool.size()
	_next[kind] = i + 1
	return _pool[i]


func _take_2d() -> AudioStreamPlayer2D:
	for pl in _pool_2d:
		if not pl.playing:
			return pl
	if _pool_2d.size() < POOL_2D:
		var n := AudioStreamPlayer2D.new()
		_add_player(n, "SFX")
		_pool_2d.append(n)
		return n
	var i: int = _next["2d"] % _pool_2d.size()
	_next["2d"] = i + 1
	return _pool_2d[i]


func _take_3d() -> AudioStreamPlayer3D:
	for pl in _pool_3d:
		if not pl.playing:
			return pl
	if _pool_3d.size() < POOL_3D:
		var n := AudioStreamPlayer3D.new()
		n.unit_size = 6.0
		n.max_distance = 80.0
		_add_player(n, "SFX")
		_pool_3d.append(n)
		return n
	var i: int = _next["3d"] % _pool_3d.size()
	_next["3d"] = i + 1
	return _pool_3d[i]


# ------------------------------------------------------------------ music + ambience

## Cross-fades to music `id` ("title", "battle", "boss", "victory", "defeat"). Same id = no-op.
## Empty id or unknown id stops the music.
func play_music(id: String, crossfade: float = 1.5) -> void:
	if id == current_music and id != "" and (_music[_music_active].playing or silent):
		return
	var entry: Dictionary = registry.get("music", {}).get(id, {})
	var stream := _stream(str(entry.get("file", "")), bool(entry.get("loop", true))) if not entry.is_empty() else null
	if stream == null and id != "":
		_warn_once("music:" + id)
	current_music = id if stream != null else ""
	_music_active = _crossfade(_music, _music_active, stream, crossfade)


func stop_music(fade: float = 1.0) -> void:
	current_music = ""
	_music_active = _crossfade(_music, _music_active, null, fade)


## Starts ambience loop `id` (e.g. "amb_wind"), cross-fading from the current one.
func play_ambience(id: String, crossfade: float = 2.0) -> void:
	if id == current_ambience and id != "" and (_amb[_amb_active].playing or silent):
		return
	var entry: Dictionary = registry.get("ambience", {}).get(id, {})
	var files: Array = entry.get("files", [])
	var stream := _stream(str(files[0]), true) if not files.is_empty() else null
	if stream == null and id != "":
		_warn_once("ambience:" + id)
	current_ambience = id if stream != null else ""
	_amb_active = _crossfade(_amb, _amb_active, stream, crossfade)


## Ambience for a bible tower `theme` ("Nature", "Fire", ... "Mixed").
func play_ambience_for_theme(theme: String, crossfade: float = 2.0) -> void:
	play_ambience(str(registry.get("theme_ambience", {}).get(theme, "")), crossfade)


func stop_ambience(fade: float = 1.5) -> void:
	current_ambience = ""
	_amb_active = _crossfade(_amb, _amb_active, null, fade)


func _crossfade(pair: Array[AudioStreamPlayer], active: int, stream: AudioStream, t: float) -> int:
	var old := pair[active]
	var nxt := 1 - active
	var neu := pair[nxt]
	var fading := t > 0.0 and is_inside_tree()
	_kill_fade(old)
	_kill_fade(neu)  # a fade-out still running on the player we are about to reuse would stop() it
	if old.playing:
		if not fading:
			old.stop()
		else:
			var tw := create_tween()
			tw.tween_property(old, "volume_db", -60.0, t)
			tw.tween_callback(old.stop)
			_fades[old] = tw
	if stream == null:
		return active
	neu.stop()
	neu.stream = stream
	neu.volume_db = -60.0 if fading else 0.0
	if silent:
		return nxt
	neu.play()
	if fading:
		var tw_in := create_tween()
		tw_in.tween_property(neu, "volume_db", 0.0, t).set_trans(Tween.TRANS_SINE)
		_fades[neu] = tw_in
	return nxt


func _kill_fade(p: AudioStreamPlayer) -> void:
	var tw: Tween = _fades.get(p)
	if tw and tw.is_valid():
		tw.kill()
	_fades.erase(p)


# ------------------------------------------------------------------ voice

## md5 key used by voice_index.json for a {speaker, line} pair (same as eleven_voices.py).
static func voice_key(speaker: String, line: String) -> String:
	return (speaker + "\n" + line).md5_text()


## True when a rendered file exists for this line id.
func has_voice(line_id: String) -> bool:
	var path := str(voice_index.get("by_id", {}).get(line_id, ""))
	return path != "" and ResourceLoader.exists(path)


## Plays a voice line by id; returns false (silently) when it has not been rendered.
func play_voice(line_id: String) -> bool:
	var path := str(voice_index.get("by_id", {}).get(line_id, ""))
	if path == "" or not ResourceLoader.exists(path):
		return false
	var stream := _stream(path)
	if stream == null:
		return false
	_voice.stop()
	_voice.stream = stream
	_voice_line = line_id
	if not silent:
		_voice.play()
	return true


## Plays the line the dialogue box is showing ({speaker, line} from story.gd). Silent if missing.
func play_voice_line(speaker: String, line: String) -> bool:
	var id := str(voice_index.get("by_key", {}).get(voice_key(speaker, line), ""))
	return play_voice(id) if id != "" else false


func stop_voice() -> void:
	if _voice and _voice.playing:
		_voice.stop()
		_on_voice_finished()


func is_voice_playing() -> bool:
	return _voice != null and _voice.playing


func _on_voice_finished() -> void:
	var id := _voice_line
	_voice_line = ""
	voice_finished.emit(id)


func _process(delta: float) -> void:
	var target := DUCK_DB if is_voice_playing() else 0.0
	if not is_equal_approx(_duck, target):
		_duck = move_toward(_duck, target, DUCK_SPEED * delta)
		_apply_volume("Music")


## Stops every player (called on exit so no playback outlives the node).
func stop_all() -> void:
	for p in _fades.keys():
		_kill_fade(p)
	for c in get_children():
		if c.has_method("stop"):
			c.call("stop")


func _notification(what: int) -> void:
	if what == NOTIFICATION_EXIT_TREE or what == NOTIFICATION_WM_CLOSE_REQUEST:
		stop_all()


# ------------------------------------------------------------------ helpers

func _add_player(p: Node, bus: String) -> Node:
	p.set("bus", bus)
	add_child(p)
	return p


func _stream(path: String, loop: bool = false) -> AudioStream:
	if path == "":
		return null
	if _streams.has(path):
		return _streams[path]
	if not ResourceLoader.exists(path):
		return null
	var s := load(path) as AudioStream
	if s == null:
		return null
	if loop and "loop" in s:
		s.set("loop", true)
	_streams[path] = s
	return s


func _read_json(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	return parsed if parsed is Dictionary else {}


func _warn_once(id: String) -> void:
	if _warned.has(id):
		return
	_warned[id] = true
	push_warning("AudioManager: no sound for '%s'" % id)
